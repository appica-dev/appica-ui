{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["svelte", "vite/client"],
    "paths": {
      "@appica/ui-svelte": ["../../packages/svelte/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
